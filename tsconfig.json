{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "types": ["@webgpu/types"],
    "incremental": true,
    "baseUrl": "./src",
    "paths": {
      "@/actions/*": ["actions/*"],
      "@/actions": ["actions/index"],
      "@/app/*": ["app/*"],
      "@/app": ["app/index"],
      "@/components/*": ["components/*"],
      "@/components": ["components/index"],
      "@/contexts/*": ["contexts/*"],
      "@/contexts": ["contexts/index"],
      "@/hooks/*": ["hooks/*"],
      "@/hooks": ["hooks/index"],
      "@/providers/*": ["providers/*"],
      "@/providers": ["providers/index"],
      "@/reducers/*": ["reducers/*"],
      "@/reducers": ["reducers/index"],
      "@/styles/*": ["styles/*"],
      "@/styles": ["styles/index"],
      "@/types/*": ["types/*"],
      "@/types": ["types/index"],
      "@/utilities/*": ["utilities/*"],
      "@/utilities": ["utilities/index"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
